# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service-role key — server-only, bypasses Row-Level Security. Never expose
# this to the browser or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google AI Studio (aistudio.google.com) -> Get API Key. Free tier, no
# billing card required for gemini-3.5-flash. Google retires Gemini model
# IDs on a published schedule (ai.google.dev/gemini-api/docs/deprecations)
# -- if ingestion or chat ever degrades with a 404-shaped failure again,
# check that page and bump the model string in src/app/api/ingest/route.ts
# and src/app/api/chat/route.ts together.
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key

# Shared secret between GitHub Actions and the /api/ingest route.
# Generate with: openssl rand -hex 32
CRON_SECRET=generate-a-long-random-string
